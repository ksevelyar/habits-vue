{
  "name": "habits",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint-js": "oxlint src tests",
    "lint-css": "stylelint src",
    "format": "oxfmt src tests package.json package-lock.json vite.config.js .stylelintrc.json .oxlintrc.json .oxfmtrc.json",
    "format-check": "oxfmt --check src tests package.json package-lock.json vite.config.js .stylelintrc.json .oxlintrc.json .oxfmtrc.json",
    "lint": "npm run lint-js && npm run lint-css && npm run format-check",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "d3": "^7.9.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@pinia/testing": "^2.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "cross-fetch": "^4.1.0",
    "jsdom": "^31.0.0",
    "msw": "^3.0.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "postcss-html": "^2.0.0",
    "pug": "^3.0.4",
    "stylelint": "^18.0.0",
    "stylelint-config-recommended": "^19.0.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
