{
  "name": "habits",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint-js": "oxlint src tests",
    "lint-css": "stylelint src",
    "format": "oxfmt src tests package.json package-lock.json vite.config.js postcss.config.js .stylelintrc.json .postcssrc.json .oxlintrc.json .oxfmtrc.json",
    "format-check": "oxfmt --check src tests package.json package-lock.json vite.config.js postcss.config.js .stylelintrc.json .postcssrc.json .oxlintrc.json .oxfmtrc.json",
    "lint": "npm run lint-js && npm run lint-css && npm run format-check",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "pinia": "^2.0.13",
    "vue": "^3.4.35",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.4.6",
    "cross-fetch": "^3.1.5",
    "jsdom": "^24.1.1",
    "msw": "^2.15.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.4.12",
    "postcss-html": "^1.3.0",
    "postcss-syntax": "^0.36.2",
    "pug": "^3.0.2",
    "stylelint": "^14.6.1",
    "stylelint-config-sugarss-recommended": "^3.0.0",
    "sugarss": "^5.0.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
